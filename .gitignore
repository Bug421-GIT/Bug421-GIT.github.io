# WorkBuddy 工作区数据（不提交）
.workbuddy/

# Jekyll 构建产物（由 GitHub Actions 生成，不进仓库）
_site/
.jekyll-cache/
.sass-cache/

# obsidian数据
.obsidian/

# 平台相关的 Gemfile.lock（Windows 生成的锁含 x64-mingw-ucrt 原生 gem，
# 无法在 GitHub Actions 的 Linux  runner 上安装，故不提交，由 CI 重新生成）
/Gemfile.lock

# DSH 工作区数据不提交
__dsh_probe_tool.tmp

# 字体构建输入/依赖（原始 TTF 每个 20 MB，不入库；生成物 woff2 才入库）
assets/fonts/_build/raw/
assets/fonts/_build/node_modules/